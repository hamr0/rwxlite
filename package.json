{
  "name": "rwxlite",
  "version": "0.2.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamr0/rwxlite.git"
  },
  "homepage": "https://github.com/hamr0/rwxlite#readme",
  "bugs": {
    "url": "https://github.com/hamr0/rwxlite/issues"
  },
  "keywords": [
    "openapi",
    "http",
    "classifier",
    "read-write-execute",
    "onnx",
    "minilm",
    "rwx"
  ],
  "type": "module",
  "description": "A small local classifier that says whether an API operation reads (r), writes (w) or can't be taken back (x).",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "types/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.js",
    "manifest": "node m1/manifest.mjs",
    "bench": "node m1/bench.mjs",
    "prepack": "npm run build:types"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.31.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
