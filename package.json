{
  "name": "rwxlite",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "rwxlite: a small local r/w/x classifier (int8 MiniLM on onnxruntime-node) that answers Jev's request shape with probabilities only; plus the module 0 research scripts.",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.js",
    "manifest": "node m1/manifest.mjs",
    "bench": "node m1/bench.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.31.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
